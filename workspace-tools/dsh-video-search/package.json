{
  "name": "dsh-video-search",
  "version": "0.1.0",
  "private": true,
  "description": "Video search tool for DeepSeek Harness: search Bilibili and hand the result to video_understand, so the agent actively looks for videos during research",
  "type": "module",
  "main": "dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dsh/",
    "engine/",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "video-search",
    "bilibili"
  ],
  "license": "MIT"
}
